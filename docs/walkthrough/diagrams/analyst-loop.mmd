graph LR
    IN([上游节点]) --> A[Analyst Node<br/>llm.bind_tools.invoke]
    A --> C{messages -1<br/>has tool_calls?}
    C -- YES --> T[ToolNode<br/>执行工具]
    T --> A
    C -- NO --> CL[Msg Clear Node<br/>清空消息历史]
    CL --> OUT([下一个 analyst])

    classDef analyst fill:#e1f5ff,stroke:#0288d1
    classDef tool fill:#fff3e0,stroke:#f57c00
    classDef clear fill:#f5f5f5,stroke:#9e9e9e,stroke-dasharray: 3 3
    classDef cond fill:#ffe0b2,stroke:#fb8c00

    class A analyst
    class T tool
    class CL clear
    class C cond
