graph TD
    START([START]) --> A1[Market Analyst]
    A1 -.tool_calls.-> T1[tools_market]
    T1 --> A1
    A1 --> C1[Msg Clear Market]
    C1 --> A2[Sentiment Analyst]
    A2 -.tool_calls.-> T2[tools_social]
    T2 --> A2
    A2 --> C2[Msg Clear Sentiment]
    C2 --> A3[News Analyst]
    A3 -.tool_calls.-> T3[tools_news]
    T3 --> A3
    A3 --> C3[Msg Clear News]
    C3 --> BR[Bull Researcher]
    BR -.count under cap.-> BE[Bear Researcher]
    BE -.count under cap.-> BR
    BR -.count over cap.-> RM[Research Manager]
    BE -.count over cap.-> RM
    RM --> TR[Trader]
    TR --> AG[Aggressive Analyst]
    AG -.count under cap.-> CO[Conservative Analyst]
    CO -.count under cap.-> NE[Neutral Analyst]
    NE -.count under cap.-> AG
    AG -.count over cap.-> PM[Portfolio Manager]
    CO -.count over cap.-> PM
    NE -.count over cap.-> PM
    PM --> RG[Risk Gate]
    RG --> MP[Mark Price]
    MP --> EX[Executor]
    EX --> END2([END])

    classDef analyst fill:#e1f5ff,stroke:#0288d1
    classDef tool fill:#fff3e0,stroke:#f57c00
    classDef clear fill:#f5f5f5,stroke:#9e9e9e,stroke-dasharray: 3 3
    classDef debate fill:#fce4ec,stroke:#c2185b
    classDef manager fill:#e8f5e9,stroke:#388e3c
    classDef futures fill:#fff9c4,stroke:#f9a825,stroke-width:2px
    classDef endpoint fill:#fff,stroke:#000,stroke-width:2px

    class A1,A2,A3 analyst
    class T1,T2,T3 tool
    class C1,C2,C3 clear
    class BR,BE,AG,CO,NE debate
    class RM,TR,PM manager
    class RG,MP,EX futures
    class START,END2 endpoint
